# TradeGuard AI Configuration Example

# FastAPI Backend Settings
APP_NAME="TradeGuard AI"
APP_VERSION="1.2.0"
DEBUG=True
PORT=8000
HOST="127.0.0.1"

# Database Configuration (PostgreSQL / SQLite fallback)
# For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/tradeguard"
# For Local SQLite:
DATABASE_URL="sqlite+aiosqlite:///./tradeguard.db"

# Redis Cache (Optional)
REDIS_URL="redis://localhost:6379/0"

# Security & Secrets
SECRET_KEY="tradeguard-super-secret-jwt-key-2026-audit-key"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
TRADINGVIEW_WEBHOOK_SECRET="tg_tv_sec_893b1657ff1fc53"

# Stellar Soroban Smart Contract
STELLAR_NETWORK="TESTNET"
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_CONTRACT_ID="CCQJ2T75A2P2K4OQYZ6U3KBLQ6F364S432UYP3N75Z3Z5OQYZ6U3KBLQ"
# STELLAR_SECRET_KEY="S..."

# Risk Defaults (Virtual Currency: INR ₹)
DEFAULT_CAPITAL=1000000.0
DEFAULT_MAX_RISK_PER_TRADE_PCT=1.0
DEFAULT_MAX_PORTFOLIO_EXPOSURE_PCT=40.0
DEFAULT_MAX_OPEN_POSITIONS=5
DEFAULT_MAX_DAILY_LOSS_PCT=3.0

# Financial News Intelligence Provider Settings
NEWS_PROVIDER=alphavantage
ALPHAVANTAGE_API_KEY=demo_or_your_key_here
GNEWS_API_KEY=
NEWS_REFRESH_INTERVAL=300
NEWS_CACHE_TTL=300
NEWS_BREAKING_CACHE_TTL=120
NEWS_MAX_ARTICLES=50
NEWS_API_RATE_LIMIT=5
AI_API_KEY=

# Frontend Next.js Settings
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
