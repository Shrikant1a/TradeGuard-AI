# ==============================================================================
# TradeGuard AI - Production & Local Configuration Specification
# Copy this file to .env and configure your values.
# NEVER commit .env with real secrets to source control.
# ==============================================================================

# Application Environment
APP_NAME="TradeGuard AI"
APP_VERSION="1.2.0"
ENVIRONMENT="development" # Set to "production" in live environments
DEBUG=false
PORT=8000
HOST="0.0.0.0"

# ------------------------------------------------------------------------------
# 1. Database Configuration (Supabase PostgreSQL / Local Fallback)
# ------------------------------------------------------------------------------
# For Production Supabase PostgreSQL (Supports standard postgres:// or postgresql+asyncpg://):
# DATABASE_URL="postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# For Local SQLite Volume (Default in Docker Compose):
DATABASE_URL="sqlite+aiosqlite:////app/data/tradeguard.db"

# Optional Local Postgres settings (if running `docker compose --profile postgres up`):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tradeguard

# ------------------------------------------------------------------------------
# 2. Redis Cache Configuration (Upstash Redis / Local Redis)
# ------------------------------------------------------------------------------
# For Production Upstash Redis (Serverless TLS):
# REDIS_URL="rediss://default:[YOUR_UPSTASH_TOKEN]@[YOUR_ENDPOINT].upstash.io:6379"
# For Local Docker Compose Redis:
REDIS_URL="redis://redis:6379/0"

# ------------------------------------------------------------------------------
# 3. Security, CORS & Webhooks
# ------------------------------------------------------------------------------
SECRET_KEY="generate-a-secure-random-64-character-jwt-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080
TRADINGVIEW_WEBHOOK_SECRET="tg_tv_sec_generate_secure_random_hex_string"

# Allowed CORS Origins (Comma-separated list of trusted frontend URLs)
# In production, replace with your live Vercel domain:
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://tradeguard-ai.vercel.app"

# ------------------------------------------------------------------------------
# 4. Background Worker Deployment Mode
# ------------------------------------------------------------------------------
# Set to "false" when running a dedicated worker container in Docker Compose.
# Set to "true" when running single-process development without Docker.
RUN_EMBEDDED_WORKER=false

# ------------------------------------------------------------------------------
# 5. Stellar / Soroban Blockchain Audit Records
# ------------------------------------------------------------------------------
STELLAR_NETWORK="TESTNET" # TESTNET / PUBLIC / LOCAL
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_CONTRACT_ID="CCQJ2T75A2P2K4OQYZ6U3KBLQ6F364S432UYP3N75Z3Z5OQYZ6U3KBLQ"
# STELLAR_SECRET_KEY="S..." # Deployer/Signer private key (Keep private!)

# ------------------------------------------------------------------------------
# 6. Pre-Trade Risk Engine Defaults
# ------------------------------------------------------------------------------
DEFAULT_CAPITAL=1000000.0
DEFAULT_MAX_RISK_PER_TRADE_PCT=1.0
DEFAULT_MAX_PORTFOLIO_EXPOSURE_PCT=40.0
DEFAULT_MAX_OPEN_POSITIONS=5
DEFAULT_MAX_DAILY_LOSS_PCT=3.0

# ------------------------------------------------------------------------------
# 7. Financial News & Sentiment AI Pipeline
# ------------------------------------------------------------------------------
NEWS_PROVIDER="alphavantage" # alphavantage / gnews / demo
ALPHAVANTAGE_API_KEY="your_alphavantage_api_key_here"
GNEWS_API_KEY=""
NEWS_REFRESH_INTERVAL=300
NEWS_CACHE_TTL=300
NEWS_BREAKING_CACHE_TTL=120
NEWS_MAX_ARTICLES=50
NEWS_API_RATE_LIMIT=5

# Optional AI Engine Key (for external LLM sentiment/explanation refinement)
AI_API_KEY=""

# ------------------------------------------------------------------------------
# 8. Production Observability & Monitoring
# ------------------------------------------------------------------------------
# Sentry DSN for error telemetry and performance tracing
SENTRY_DSN=""

# ------------------------------------------------------------------------------
# 9. Next.js Frontend Configuration (Vercel)
# ------------------------------------------------------------------------------
# URL pointing to the FastAPI Dockerized backend
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
BACKEND_INTERNAL_URL="http://127.0.0.1:8000"
